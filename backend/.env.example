# ─────────────────────────────────────────────────────────────────────────────
# X-Hunt Auth Service — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Your project REST URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — full DB access, bypasses RLS; never expose to clients
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST match JWT_SECRET in the Next.js environment exactly.
# Generate: openssl rand -hex 64
JWT_SECRET=replace-with-a-64-char-random-hex-string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,https://xhunt.app

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=production

# ── Integrations (background worker — optional at auth service startup) ────────
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_APP_URL=https://xhunt.app
CRON_SECRET=
GROQ_API_KEY=
